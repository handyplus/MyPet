            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
            <id>mypet-local-libraries</id>
            <url>file://${project.basedir}/lib/repository</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <!-- Keep these repository IDs for cached third-party artifacts; private de.keyle dependencies resolve first from lib/repository. -->
