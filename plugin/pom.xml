    <build>
        <finalName>MyPet-${project.version}</finalName>

        <resources>
            <!-- plugin.yml is the only resource with placeholders -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
            <!-- Translations cloned from MyPet-Translations -->
            <resource>
                <directory>${translations.dir}</directory>
                <targetPath>locale</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>*.properties</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Download translations once (delete target/translations to refresh) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-translations</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:unless="ant:unless">
                                <available file="${translations.dir}" type="dir" property="translations.present"/>
                                <exec executable="git" failonerror="true" unless:set="translations.present">
                                    <arg value="clone"/>
                                    <arg value="--depth"/>
                                    <arg value="1"/>
                                    <arg value="--single-branch"/>
                                    <arg value="https://github.com/MyPetORG/MyPet-Translations.git"/>
                                    <arg value="${translations.dir}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate de/Keyle/MyPet/class-index.txt (used by BuildIntegrity) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>class-index</id>
                        <phase>prepare-package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${maven.multiModuleProjectDirectory}/build-tools/ClassIndex.java</argument>
                                <argument>${project.build.outputDirectory}/de/Keyle/MyPet/class-index.txt</argument>
                                <argument>${project.build.outputDirectory}</argument>
                                <argument>${project.basedir}/../api/target/classes</argument>
                                <argument>${project.basedir}/../skills/target/classes</argument>
                                <argument>${project.basedir}/../nms/v26_3_R1/target/classes</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>de.Keyle.MyPet.util.metrics</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>de.Keyle.MyPet.util.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>de.keyle.knbt</pattern>
                                    <shadedPattern>de.Keyle.MyPet.util.nbt</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bson</pattern>
                                    <shadedPattern>de.Keyle.MyPet.util.bson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>de.Keyle.MyPet.util.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.mongodb</pattern>
                                    <shadedPattern>de.Keyle.MyPet.util.mongodb</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.sentry</pattern>
                                    <shadedPattern>de.Keyle.MyPet.util.sentry</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.Keyle.MyPet.Main</mainClass>
                                    <manifestEntries>
                                        <Class-Path>MyPet/rhino.jar MyPet/rhino-1.7.9.jar MyPet/rhino-1.7.10.jar MyPet/rhino-1.7.15.jar ../MyPet/rhino.jar ../MyPet/rhino-1.7.9.jar ../MyPet/rhino-1.7.10.jar ../MyPet/rhino-1.7.15.jar MyPet/mongo-java-driver.jar MyPet/mongo-java-driver-3.12.11.jar</Class-Path>
                                        <Project-Name>MyPet</Project-Name>
                                        <Project-Version>${project.version}</Project-Version>
                                        <Project-Build>${buildNumber}</Project-Build>
                                        <Project-Type>${buildType}</Project-Type>
                                        <Project-Minecraft-Version>${minecraft.version}</Project-Minecraft-Version>
                                        <Project-Bukkit-Packets>${bukkit.packets}</Project-Bukkit-Packets>
                                        <Special-MC-Versions>${special.versions}</Special-MC-Versions>
                                        <Git-Commit>${gitCommit}</Git-Commit>
                                        <Sentry-Dsn>${sentryDsn}</Sentry-Dsn>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
